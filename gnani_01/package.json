{
  "name": "swachhmap",
  "version": "1.0.0",
  "description": "Smart Civic Issue Reporting System",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run ai\" \"npm run client\"",
    "server": "cd backend && node server.js",
    "ai": "python3 -m uvicorn ai_service.app.main:app --host 127.0.0.1 --port 8000",
    "client": "cd frontend && npm start",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "ansi-regex": "^5.0.1",
    "ansi-styles": "^4.3.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "chalk": "^4.1.2",
    "cliui": "^8.0.1",
    "color-convert": "^2.0.1",
    "color-name": "^1.1.4",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "emoji-regex": "^8.0.0",
    "escalade": "^3.2.0",
    "express": "^5.1.0",
    "get-caller-file": "^2.0.5",
    "has-flag": "^4.0.0",
    "is-fullwidth-code-point": "^3.0.0",
    "lodash": "^4.17.21",
    "mongoose": "^8.19.2",
    "multer": "^2.0.2",
    "react-icons": "^5.5.0",
    "require-directory": "^2.1.1",
    "rxjs": "^7.8.2",
    "shell-quote": "^1.8.3",
    "spawn-command": "^0.0.2",
    "string-width": "^4.2.3",
    "strip-ansi": "^6.0.1",
    "supports-color": "^8.1.1",
    "tree-kill": "^1.2.2",
    "tslib": "^2.8.1",
