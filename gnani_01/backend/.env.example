# SwachhMap AI 2.0 Backend Configuration
PORT=8002
MONGODB_URI=mongodb://127.0.0.1:27017/swachhmap
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Storage (Optional, falls back to base64 Data URLs)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Python FastAPI AI Inference Service
AI_SERVICE_URL=http://127.0.0.1:8000

# Gnani AI API Integration (Prisma STT, Evon 30B, Timbre TTS via api.vachana.ai gateway)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_PRISMA_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_EVON_ENDPOINT=https://api.vachana.ai/v1/chat/completions
GNANI_TIMBRE_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_TIMEOUT_MS=15000


# Optional voice overrides (defaults: Nalini / Deepak). Use the probe script to compare voices available on your account.
GNANI_VOICE_FEMALE=Nalini
GNANI_VOICE_MALE=Deepak
GNANI_VOICE_CANDIDATES=Nalini,Deepak
